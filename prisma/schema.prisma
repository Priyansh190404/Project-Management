generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  progress    Int      @default(0)
  status      String   @default("In Progress")
  createdAt   DateTime @default(now())
}